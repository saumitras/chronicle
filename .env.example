# Copy to .env — all values optional; defaults give a fully working demo.

# LLM reasoning (empty = deterministic mock reasoning, everything still works)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# LangGraph recursion limit: graph supersteps (a model turn or a tool batch),
# not ReAct turns. Exhausting it yields a degraded result, not a fake one.
INVESTIGATION_AGENT_MAX_STEPS=8

# Alert generation cadence
ALERT_INTERVAL_SECONDS=10

# Human-in-the-loop
HITL_NOTIFY_CHANNEL=none          # email | slack | none
HITL_REVIEW_TIMEOUT_SECONDS=172800  # auto-expire unreviewed cases after 48h
# Base URL of the dashboard, used for the review link in notifications
# DOMAIN=http://localhost:3000
# Email notifications (HITL_NOTIFY_CHANNEL=email)
# HITL_EMAIL_FROM=noreply@example.com
# HITL_EMAIL_TO=
# RESEND_API_KEY=
# SLACK_BOT_TOKEN=
# SLACK_CHANNEL=agentapprovals

# Outbox relay
OUTBOX_POLL_INTERVAL_SECONDS=0.5
OUTBOX_BATCH_SIZE=100
